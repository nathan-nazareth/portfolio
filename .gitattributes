# Keep the working tree LF so diffs and build output behave the same on every machine.
# `text=auto` lets Git detect binaries on its own; `eol=lf` overrides the global
# core.autocrlf=true so checked-out files are LF, not CRLF.
*      text=auto eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.svg  text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
